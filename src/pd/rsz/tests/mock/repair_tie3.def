VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 120000 120000 ) ;
COMPONENTS 8 ;
 - t1 EM_TIEHI ;
 - u0 EM_BUF_X1 + PLACED ( 20000 20000 ) N ;
 - u1 EM_BUF_X1 + PLACED ( 40000 20000 ) N ;
 - u2 EM_BUF_X1 + PLACED ( 20000 40000 ) N ;
 - u3 EM_BUF_X1 + PLACED ( 40000 40000 ) N ;
 - u4 EM_BUF_X1 + PLACED ( 20000 60000 ) N ;
 - pad1 PAD + FIXED ( 20000 100000 ) N ;
 - pad2 PAD + FIXED ( 40000 100000 ) N ;
END COMPONENTS
NETS 1 ;
- n1 ( t1 Z )   ( u0 A )
  ( u1 A )  ( u2 A )  ( u3 A )  ( u4 A ) ( pad1 TRIEN ) ( pad2 TRIEN ) + USE SIGNAL ;
END NETS
END DESIGN
