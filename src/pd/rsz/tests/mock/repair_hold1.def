VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 200000 200000 ) ;
COMPONENTS 13 ;
    - i1 EM_BUF_X1 + PLACED ( 81700 86800 ) N ;
    - i2 EM_BUF_X1 + PLACED ( 82840 86800 ) N ;
    - i3 EM_BUF_X1 + PLACED ( 86640 84000 ) FS ;
    - i4 EM_BUF_X1 + PLACED ( 80180 89600 ) FS ;
    - i5 EM_BUF_X1 + PLACED ( 83980 86800 ) N ;
    - i6 EM_BUF_X1 + PLACED ( 81320 89600 ) FS ;
    - i7 EM_BUF_X1 + PLACED ( 87780 84000 ) FS ;
    - i8 EM_BUF_X1 + PLACED ( 85120 86800 ) N ;
    - r1 EM_DFF_X1 + PLACED ( 80180 81200 ) N ;
    - r2 EM_DFF_X1 + PLACED ( 80180 84000 ) FS ;
    - r3 EM_DFF_X1 + PLACED ( 86640 81200 ) N ;
    - u1 EM_BUF_X1 + PLACED ( 82460 89600 ) FS ;
    - u2 EM_AND2_X1 + PLACED ( 80180 86800 ) N ;
END COMPONENTS
PINS 4 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER em2 ( 0 0 ) ( 0 0 )
        + FIXED ( 80000 0 ) N ;
    - in1 + NET in1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER em2 ( 0 0 ) ( 0 0 )
        + FIXED ( 60000 0 ) N ;
    - in2 + NET in2 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER em2 ( 0 0 ) ( 0 0 )
        + FIXED ( 40000 0 ) N ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER em2 ( 0 0 ) ( 0 0 )
        + FIXED ( 0 0 ) N ;
END PINS
NETS 16 ;
    - clk ( PIN clk ) ( i1 A ) + USE SIGNAL ;
    - i1z ( i1 Z ) ( i2 A ) ( r1 CK ) + USE SIGNAL ;
    - i2z ( i2 Z ) ( i3 A ) + USE SIGNAL ;
    - i3z ( i3 Z ) ( i4 A ) + USE SIGNAL ;
    - i4z ( i4 Z ) ( i5 A ) ( r2 CK ) + USE SIGNAL ;
    - i5z ( i5 Z ) ( i6 A ) + USE SIGNAL ;
    - i6z ( i6 Z ) ( i7 A ) + USE SIGNAL ;
    - i7z ( i7 Z ) ( i8 A ) + USE SIGNAL ;
    - i8z ( i8 Z ) ( r3 CK ) + USE SIGNAL ;
    - in1 ( PIN in1 ) ( r1 D ) + USE SIGNAL ;
    - in2 ( PIN in2 ) ( r2 D ) + USE SIGNAL ;
    - out ( PIN out ) ( r3 Q ) + USE SIGNAL ;
    - r1q ( r1 Q ) ( u2 A1 ) + USE SIGNAL ;
    - r2q ( r2 Q ) ( u1 A ) + USE SIGNAL ;
    - u1z ( u1 Z ) ( u2 A2 ) + USE SIGNAL ;
    - u2z ( u2 ZN ) ( r3 D ) + USE SIGNAL ;
END NETS
END DESIGN
