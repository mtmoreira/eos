VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 2000 ;
COMPONENTS 15 ;
    - i1 EM_BUF_X2 + PLACED ( 200 200 ) N ;
    - i2 EM_BUF_X2 + PLACED ( 200 400 ) N ;
    - i3 EM_BUF_X2 + PLACED ( 200 600 ) N ;
    - i4 EM_BUF_X2 + PLACED ( 200 800 ) N ;
    - i5 EM_BUF_X2 + PLACED ( 200 1000 ) N ;
    - i6 EM_BUF_X2 + PLACED ( 200 1200 ) N ;
    - i7 EM_BUF_X2 + PLACED ( 200 1400 ) N ;
    - r1 EM_DFF_X1 + PLACED ( 400 400 ) N ;
    - r2 EM_DFF_X1 + PLACED ( 400 600 ) N ;
    - r3 EM_DFF_X1 + PLACED ( 400 800 ) N ;
    - r4 EM_DFF_X1 + PLACED ( 400 1000 ) N ;
    - u1 EM_BUF_X2 + PLACED ( 400 1200 ) N ;
    - u2 EM_BUF_X2 + PLACED ( 400 1200 ) N ;
    - u3 EM_BUF_X2 + PLACED ( 400 1200 ) N ;
    - u4 EM_BUF_X2 + PLACED ( 400 1200 ) N ;
END COMPONENTS
PINS 1 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL ;
END PINS
NETS 13 ;
    - clk ( PIN clk ) ( i1 A ) + USE SIGNAL ;
    - i1z ( i1 Z ) ( i2 A ) ( r1 CK ) + USE SIGNAL ;
    - i2z ( i2 Z ) ( i3 A ) + USE SIGNAL ;
    - i3z ( i3 Z ) ( i4 A ) + USE SIGNAL ;
    - i4z ( i4 Z ) ( i5 A ) + USE SIGNAL ;
    - i5z ( i5 Z ) ( i6 A ) + USE SIGNAL ;
    - i6z ( i6 Z ) ( i7 A ) + USE SIGNAL ;
    - i7z ( i7 Z ) ( r2 CK ) ( r3 CK ) ( r4 CK ) + USE SIGNAL ;

    - r1q ( r1 Q ) ( u1 A ) + USE SIGNAL ;
    - u1z ( u1 Z ) ( u2 A ) ( r2 D ) + USE SIGNAL ;
    - u2z ( u2 Z ) ( u3 A ) ( r3 D ) + USE SIGNAL ;
    - u3z ( u3 Z ) ( u4 A ) + USE SIGNAL ;
    - u4z ( u4 Z ) ( r4 D ) + USE SIGNAL ;
END NETS
END DESIGN
