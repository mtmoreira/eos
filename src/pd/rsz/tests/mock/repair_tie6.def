VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 2000 ;

DIEAREA ( 0 0 ) ( 80000 80000 ) ;

COMPONENTS 2 ;
 - t1 EM_TIEHI + PLACED ( 20000 40000 ) N ;
 - u0 EM_BUF_X1 + PLACED ( 20000 20000 ) N ;
END COMPONENTS

PINS 1 ;
- tie1 + NET n1 + DIRECTION OUTPUT + USE SIGNAL + SPECIAL 
  + LAYER em1 ( 200 0 ) ( 200 200 ) + FIXED ( 2000 2000 ) N ;
END PINS

NETS 1 ;
- n1 ( t1 Z ) ( u0 A )  ( PIN tie1 ) + USE SIGNAL ;
END NETS
END DESIGN
