VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 120000 220000 ) ;
TRACKS Y 70 DO 786 STEP 140 LAYER em1 ;
TRACKS X 95 DO 316 STEP 190 LAYER em2 ;
TRACKS Y 70 DO 786 STEP 140 LAYER em3 ;
TRACKS X 95 DO 214 STEP 280 LAYER em4 ;
TRACKS Y 70 DO 393 STEP 280 LAYER em5 ;
TRACKS X 95 DO 214 STEP 280 LAYER em6 ;
TRACKS Y 70 DO 138 STEP 800 LAYER em7 ;
TRACKS X 95 DO 75 STEP 800 LAYER em8 ;
TRACKS Y 70 DO 69 STEP 1600 LAYER em9 ;
TRACKS X 95 DO 38 STEP 1600 LAYER em10 ;
COMPONENTS 5 ;
    - t1 EM_TIEHI + PLACED ( 400 400 ) N ;
    - u1 EM_BUF_X1 + PLACED ( 4000 400 ) N ;
    - u2 EM_BUF_X1 + PLACED ( 8000 400 ) N ;
    - pad1 PAD + FIXED ( 0 12000 ) N ;
    - pad2 PAD + FIXED ( 60000 12000 ) N ;
END COMPONENTS
NETS 1 ;
    - n1 ( t1 Z ) ( u1 A ) ( u2 A ) ( pad1 TRIEN ) ( pad2 TRIEN ) + USE SIGNAL ;
END NETS
END DESIGN
