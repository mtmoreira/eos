VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 120000 120000 ) ;
COMPONENTS 6 ;
 - t1 EM_TIEHI ;
 - u0 EM_BUF_X1 + PLACED ( 20000 20000 ) N ;
 - u1 EM_BUF_X1 + PLACED ( 100000 20000 ) FN ;
 - u2 EM_BUF_X1 + PLACED ( 20000 40000 ) N ;
 - u3 EM_BUF_X1 + PLACED ( 100000 40000 ) FN ;
END COMPONENTS
NETS 1 ;
- n1 ( t1 Z )   ( u0 A )
  ( u1 A )  ( u2 A )  ( u3 A )  + USE SIGNAL ;
END NETS
END DESIGN
