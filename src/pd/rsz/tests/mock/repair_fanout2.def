VERSION 5.8 ; 
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN hi_fanout ;

UNITS DISTANCE MICRONS 2000 ;

DIEAREA ( 0 0 ) ( 4000 4000 ) ;

COMPONENTS 16 ;
- r1 EM_DFFR_X1 + PLACED ( 10000 0 ) N ;
- r2 EM_DFFR_X1 + PLACED ( 20000 0 ) N ;
- r3 EM_DFFR_X1 + PLACED ( 30000 0 ) N ;
- r4 EM_DFFR_X1 + PLACED ( 40000 0 ) N ;
- r5 EM_DFFR_X1 + PLACED ( 50000 0 ) N ;
- r6 EM_DFFR_X1 + PLACED ( 60000 0 ) N ;
- r7 EM_DFFR_X1 + PLACED ( 70000 0 ) N ;
- r8 EM_DFFR_X1 + PLACED ( 80000 0 ) N ;
- r9 EM_DFFR_X1 + PLACED ( 90000 0 ) N ;
- r10 EM_DFFR_X1 + PLACED ( 0 10000 ) N ;
- r11 EM_DFFR_X1 + PLACED ( 10000 10000 ) N ;
- r12 EM_DFFR_X1 + PLACED ( 20000 10000 ) N ;
- r13 EM_DFFR_X1 + PLACED ( 30000 10000 ) N ;
- r14 EM_DFFR_X1 + PLACED ( 40000 10000 ) N ;
- r15 EM_DFFR_X1 + PLACED ( 50000 10000 ) N ;
- B1 EM_BUF_X1 ;
END COMPONENTS

PINS 1 ;
- RESET_IN + NET RESET_IN + DIRECTION INPUT + USE SIGNAL + SPECIAL ;
END PINS

SPECIALNETS 3 ;
- VSS  ( * VSS )
  + USE GROUND ;
- VDD  ( * VDD )
  + USE POWER ;
- RESET ( B1 Z ) ( * RN ) 
  + USE SIGNAL ;
END SPECIALNETS

NETS 1 ;
- RESET_IN ( PIN RESET_IN ) ( B1 A ) ;
END NETS

END DESIGN
