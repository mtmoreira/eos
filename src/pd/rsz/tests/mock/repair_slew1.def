VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN hi_fanout ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 60000 70000 ) ;

COMPONENTS 31 ;
- drvr EM_DFF_X1 + PLACED ( 2000 2000 ) N ;
- load0 EM_DFF_X1 + PLACED ( 0 0 ) N ;
- load1 EM_DFF_X1 + PLACED ( 10000 0 ) N ;
- load2 EM_DFF_X1 + PLACED ( 20000 0 ) N ;
- load3 EM_DFF_X1 + PLACED ( 30000 0 ) N ;
- load4 EM_DFF_X1 + PLACED ( 40000 0 ) N ;
- load5 EM_DFF_X1 + PLACED ( 0 10000 ) N ;
- load6 EM_DFF_X1 + PLACED ( 10000 10000 ) N ;
- load7 EM_DFF_X1 + PLACED ( 20000 10000 ) N ;
- load8 EM_DFF_X1 + PLACED ( 30000 10000 ) N ;
- load9 EM_DFF_X1 + PLACED ( 40000 10000 ) N ;
- load10 EM_DFF_X1 + PLACED ( 0 20000 ) N ;
- load11 EM_DFF_X1 + PLACED ( 10000 20000 ) N ;
- load12 EM_DFF_X1 + PLACED ( 20000 20000 ) N ;
- load13 EM_DFF_X1 + PLACED ( 30000 20000 ) N ;
- load14 EM_DFF_X1 + PLACED ( 40000 20000 ) N ;
- load15 EM_DFF_X1 + PLACED ( 0 30000 ) N ;
- load16 EM_DFF_X1 + PLACED ( 10000 30000 ) N ;
- load17 EM_DFF_X1 + PLACED ( 20000 30000 ) N ;
- load18 EM_DFF_X1 + PLACED ( 30000 30000 ) N ;
- load19 EM_DFF_X1 + PLACED ( 40000 30000 ) N ;
- load20 EM_DFF_X1 + PLACED ( 0 40000 ) N ;
- load21 EM_DFF_X1 + PLACED ( 10000 40000 ) N ;
- load22 EM_DFF_X1 + PLACED ( 20000 40000 ) N ;
- load23 EM_DFF_X1 + PLACED ( 30000 40000 ) N ;
- load24 EM_DFF_X1 + PLACED ( 40000 40000 ) N ;
- load25 EM_DFF_X1 + PLACED ( 0 50000 ) N ;
- load26 EM_DFF_X1 + PLACED ( 10000 50000 ) N ;
- load27 EM_DFF_X1 + PLACED ( 20000 50000 ) N ;
- load28 EM_DFF_X1 + PLACED ( 30000 50000 ) N ;
- load29 EM_DFF_X1 + PLACED ( 40000 50000 ) N ;
END COMPONENTS

PINS 1 ;
- clk1 + NET clk1 + DIRECTION INPUT + USE SIGNAL
+ LAYER em1 ( 0 0 ) ( 200 200 ) + FIXED ( 2000 2000 ) N ;
END PINS

SPECIALNETS 2 ;
- VSS  ( * VSS )
  + USE GROUND ;
- VDD  ( * VDD )
  + USE POWER ;
END SPECIALNETS

NETS 2 ;
- clk1 ( PIN clk1 ) ( drvr CK ) ( load0 CK )
 ( load1 CK ) ( load2 CK ) ( load3 CK ) ( load4 CK ) ( load5 CK ) ( load6 CK ) ( load7 CK ) ( load8 CK ) ( load9 CK ) ( load10 CK )
 ( load11 CK ) ( load12 CK ) ( load13 CK ) ( load14 CK ) ( load15 CK ) ( load16 CK ) ( load17 CK ) ( load18 CK ) ( load19 CK ) ( load20 CK )
 ( load21 CK ) ( load22 CK ) ( load23 CK ) ( load24 CK ) ( load25 CK ) ( load26 CK ) ( load27 CK ) ( load28 CK ) ( load29 CK ) ;

- net0 ( drvr Q ) ( load0 D )
 ( load1 D ) ( load2 D ) ( load3 D ) ( load4 D ) ( load5 D ) ( load6 D ) ( load7 D ) ( load8 D ) ( load9 D ) ( load10 D )
 ( load11 D ) ( load12 D ) ( load13 D ) ( load14 D ) ( load15 D ) ( load16 D ) ( load17 D ) ( load18 D ) ( load19 D ) ( load20 D )
 ( load21 D ) ( load22 D ) ( load23 D ) ( load24 D ) ( load25 D ) ( load26 D ) ( load27 D ) ( load28 D ) ( load29 D ) ;

END NETS

END DESIGN
