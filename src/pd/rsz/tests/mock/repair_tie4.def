VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 2000 ;

DIEAREA ( 0 0 ) ( 100000 100000 ) ;

COMPONENTS 11 ;
    - t1 EM_TIEHI ;
 - u0 EM_BUF_X1 + PLACED ( 20000 20000 ) N ;
 - u1 EM_BUF_X1 + PLACED ( 40000 20000 ) N ;
 - u2 EM_BUF_X1 + PLACED ( 60000 20000 ) N ;
 - u3 EM_BUF_X1 + PLACED ( 20000 40000 ) N ;
 - u4 EM_BUF_X1 + PLACED ( 40000 40000 ) N ;
 - u5 EM_BUF_X1 + PLACED ( 60000 40000 ) N ;
 - u6 EM_BUF_X1 + PLACED ( 20000 60000 ) N ;
 - u7 EM_BUF_X1 + PLACED ( 40000 60000 ) N ;
 - u8 EM_BUF_X1 + PLACED ( 60000 60000 ) N ;
 - u9 EM_BUF_X1 + PLACED ( 20000 80000 ) N ;
END COMPONENTS
NETS 1 ;
- n1 ( t1 Z )   ( u0 A )
  ( u1 A )  ( u2 A )  ( u3 A )  ( u4 A )  ( u5 A )
  ( u6 A )  ( u7 A )  ( u8 A )  ( u9 A ) + USE SIGNAL ;
END NETS
END DESIGN
